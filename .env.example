# Local development database (SQLite; no separate database server needed)
DATABASE_URL=sqlite:///./agentmesh.sqlite3

# Security
SECRET_KEY=replace-with-a-random-secret-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# AI provider settings (credentials stay on the backend)
AI_PROVIDER=openai
AI_MODE=demo
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Application Settings
APP_NAME=AI Agent Marketplace
ENVIRONMENT=development  # development, staging, production
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
